# ==============================================================================
# FALKORDB CONFIGURATION
# ==============================================================================
# For Local Docker:
# Leave defaults (localhost, port 6379, SSL false, no username/password)
#
# For FalkorDB Cloud:
# Populate with credentials from your FalkorDB Cloud dashboard:
# FALKORDB_HOST=your-cluster-id.falkordb.cloud
# FALKORDB_PORT=6379
# FALKORDB_USERNAME=default
# FALKORDB_PASSWORD=your_cloud_password_here
# FALKORDB_SSL=true
# FALKORDB_GRAPH=supply_chain
# ==============================================================================

FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false
FALKORDB_GRAPH=supply_chain

# ==============================================================================
# FREE LLM API KEYS (FOR NATURAL LANGUAGE CYPHER COPILOT)
# ==============================================================================
# Optional free keys (sign up at aistudio.google.com or console.groq.com)
# If omitted or empty, the built-in zero-key graph reasoning engine is used.
# ==============================================================================
GEMINI_API_KEY=
GROQ_API_KEY=
